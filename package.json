{
  "name": "@hongbinzuo/supermission",
  "version": "0.6.0",
  "description": "Local-first work records for AI-assisted software work. Multi-agent pipelines, team collaboration, 12 runner backends.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/hongbinzuo/supermission#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongbinzuo/supermission.git"
  },
  "bugs": {
    "url": "https://github.com/hongbinzuo/supermission/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "coding",
    "work-records",
    "pipeline",
    "multi-agent",
    "codex",
    "claude",
    "gemini",
    "aider",
    "cli",
    "local-first",
    "project-management"
  ],
  "bin": {
    "supermission": "./bin/supermission"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean --out-dir dist",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supermission": "bun src/cli.ts",
    "prepack": "bun run build",
    "test": "vitest run",
    "test:capability": "vitest run tests/capability.test.ts",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "minimatch": "^10.2.5",
    "yaml": "^2.8.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@stryker-mutator/core": "^9.3.0",
    "@stryker-mutator/typescript-checker": "^9.3.0",
    "@stryker-mutator/vitest-runner": "^9.3.0",
    "@types/node": "^24.10.1",
    "bun-types": "^1.3.3",
    "eslint": "^9.39.1",
    "fast-check": "^4.4.0",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.0.0"
  }
}
