{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node", "bun-types"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "eslint.config.js"],
  "exclude": ["dist", "node_modules", ".missions"]
}
